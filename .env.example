# ============================================
# SMTP — solo serverless (api/send-email.ts)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
FROM_NAME=Juan Fernando Uran Vanegas

# ============================================
# IA — solo serverless (api/generate-description.ts)
# ============================================
# Modelo recomendado: llama-3.3-70b-versatile
GROQ_API_KEY=gq_xxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Seguridad interna — solo serverless
# ============================================
# Clave que el frontend usa en headers X-Internal-Key (o la que definan)
# Para fases posteriores: Telegram, Supabase, etc.
INTERNAL_API_KEY=cambiar-antes-de-produccion
