# ============================================
# SMTP — solo serverless (api/send-email.ts)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion_smtp
FROM_NAME=Axyra Cuenta de cobro

# ============================================
# IA — solo serverless (api/generate-description.ts)
# ============================================
# Modelo recomendado: llama-3.3-70b-versatile
GROQ_API_KEY=gsk_tu_api_key_de_groq

# ============================================
# Seguridad interna — solo serverless
# ============================================
# Clave que el frontend usa en headers X-Internal-Key (o la que definan)
# Para fases posteriores: Telegram, Supabase, etc.
INTERNAL_API_KEY=genera_una_clave_larga_y_aleatoria

# ============================================
# Supabase — persistencia de facturas (opcional)
# ============================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_de_supabase
# Apply migrations: supabase/migrations/20260819_create_invoice_tables.sql

# ============================================
# Telegram — integración con bot (@Axyra_IA_Bot)
# ============================================
TELEGRAM_BOT_SECRET=tu_secreto_largo_compartido_con_n8n
# Header X-Telegram-Bot-Secret debe coincidir en n8n y Vercel
