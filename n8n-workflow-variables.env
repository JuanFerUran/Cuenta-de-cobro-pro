# ============================================
# n8n — Variables de Workflow (Workflow Variables)
# ============================================
# En n8n: Workflow → Settings → Variables
# ============================================

# URL base del proyecto en Vercel (cambiar por la URL real)
URL_BASE_API=https://axyra-cuenta-de-cobro-pro.vercel.app

# Secreto compartido entre n8n y Vercel (debe ser el mismo que TELEGRAM_BOT_SECRET en Vercel)
TELEGRAM_BOT_SECRET=<secreto_de_32_caracteres>

# API Key de Groq para extracción de datos con IA
GROQ_API_KEY=<tu_groq_api_key>
